# ==============================================================================
# CBSI Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER ENVIRONMENT (Place in server/.env)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/cbsi

# Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 2. CLIENT ENVIRONMENT (Place in client/.env or Netlify Environment Variables)
# ------------------------------------------------------------------------------
# Backend API URL (for Express server)
VITE_API_URL=http://localhost:5001/api

# Supabase Configuration (Optional: for Netlify + Supabase serverless mode)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
